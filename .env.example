# === Telegram ===
# Token dari @BotFather
BOT_TOKEN=

# Chat ID yang diizinkan (comma-separated). Cari via @userinfobot.
ALLOWED_CHAT_IDS=111111,222222

# Mapping chat ID -> nama tampilan (comma-separated, format id:Nama)
USER_NAMES=111111:Ryan,222222:Istri

# === OpenRouter (LLM) ===
OPENROUTER_API_KEY=
# Model teks. DeepSeek chat TIDAK bisa membaca gambar.
OPENROUTER_MODEL=deepseek/deepseek-chat
# Model vision (untuk foto struk/mutasi). Wajib model yang mendukung image input.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# === Google Sheets ===
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
SPREADSHEET_ID=

# === Runtime ===
# Timezone WAJIB eksplisit.
TZ=Asia/Jakarta
# Tanggal mulai periode budget tiap bulan (menyesuaikan gajian). Default 1.
BUDGET_START_DAY=25
